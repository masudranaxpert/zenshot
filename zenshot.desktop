[Desktop Entry]
Name=ZenShot
GenericName=Screen Capture Tool
Comment=Featherlight Lightshot-style screenshot tool
Exec=zenshot
TryExec=zenshot
Icon=zenshot
Terminal=false
Type=Application
Categories=Utility;Graphics;
Keywords=screenshot;capture;lightshot;screen;snip;zenshot;
StartupNotify=false
StartupWMClass=ZenShot
X-GNOME-UsesNotifications=true
Actions=Options;Fullscreen;

[Desktop Action Options]
Name=Options
Exec=zenshot --options

[Desktop Action Fullscreen]
Name=Save fullscreen
Exec=zenshot --save-fullscreen
